# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# On COLAB a cloned repo has no .env (it is gitignored, so it is not in the clone). Either keep
# a filled-in .env on Drive at MyDrive/.env or MyDrive/adass/.env, or let the notebook prompt.

# HuggingFace. Needs BOTH gated licences accepted on your account:
#   https://huggingface.co/google/gemma-2-2b-it
#   https://huggingface.co/datasets/walledai/AdvBench
# huggingface_hub reads this variable directly, so no login step is required.
HF_TOKEN=

# GitHub fine-grained PAT, read access to this repo. Only needed to clone it on Colab.
# Give it Contents: Read and write if you want to push results back from the runtime.
GH_TOKEN=

# Optional: only for the label-sheet tool, which is not part of this repository.
ANTHROPIC_API_KEY=
