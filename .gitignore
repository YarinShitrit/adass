# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Rotations and checkpoints written by adass.save_results / notebook section 0.1.
# The current results ARE tracked -- they are expensive to regenerate and are the record.
*.prev.json
*.tmp
s6_sweep_partial.json
*.backup.json

# Model weights are cached by huggingface_hub, never committed (~6 GB, gated licence).
models/
*.safetensors
*.bin

# Secrets. .env.example is committed and lists the keys; .env never is.
# NOTE the consequence, spelled out in adass/env.py: because this is ignored, a `git clone`
# on Colab does NOT bring a .env with it. Keep one on Drive, or let require() prompt.
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
